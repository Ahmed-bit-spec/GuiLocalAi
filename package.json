{
  "name": "local-chat",
  "version": "1.0.0",
  "description": "Offline chat GUI for local Ollama models",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist": "electron-builder -mwl"
  },
"author": {
  "name": "Ahmed",
  "email": "axmedclaahi800@gmail.com"
},
"homepage": "https://github.com/YOUR-USERNAME/local-chat",  "license": "MIT",
  "dependencies": {
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^3.4.19"
  },
  "keywords": [],
  "build": {
    "appId": "com.localchat.app",
    "productName": "Local Chat",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns"
    },
 "linux": {
  "target": ["AppImage", "deb"],
  "category": "Development",
  "icon": "build/icon.png",
  "maintainer": "Ahmed <axmedclaahi800@gmail.com>"
},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
